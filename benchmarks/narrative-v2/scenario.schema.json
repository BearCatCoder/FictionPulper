{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BearCatCoder/FictionPulper/benchmarks/narrative-v2/scenario.schema.json",
  "title": "FictionPulper Narrative Benchmark v2 scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id", "schema_version", "stable_hash", "split", "state_family",
    "reasoning_depth", "depth_bucket", "template_id", "template_family_id", "lexical_pool_id",
    "name_pool_id", "verb_pool_id", "candidate_presentation_order", "evaluation_modes", "novelty",
    "entities", "events", "intervention", "candidates", "worlds", "controls", "metadata"
  ],
  "properties": {
    "scenario_id": {"type": "string", "pattern": "^nbv2-[0-9]{3}$"},
    "schema_version": {"const": 2},
    "stable_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "split": {"enum": ["development", "test", "generalization"]},
    "state_family": {"enum": ["static_fact", "ownership", "location", "knowledge", "goal", "causal_dependency", "temporal_ordering"]},
    "reasoning_depth": {"type": "integer", "minimum": 1},
    "depth_bucket": {"enum": ["1", "2", "3", "4_plus"]},
    "template_id": {"type": "string", "minLength": 1},
    "template_family_id": {"type": "string", "minLength": 1},
    "lexical_pool_id": {"type": "string", "minLength": 1},
    "name_pool_id": {"type": "string", "minLength": 1},
    "verb_pool_id": {"type": "string", "minLength": 1},
    "candidate_presentation_order": {
      "type": "array",
      "oneOf": [
        {"prefixItems": [{"const": "X"}, {"const": "Y"}], "items": false},
        {"prefixItems": [{"const": "Y"}, {"const": "X"}], "items": false}
      ]
    },
    "evaluation_modes": {
      "type": "array",
      "prefixItems": [{"const": "forced_choice"}, {"const": "teacher_forced"}, {"const": "free_generation"}],
      "items": false
    },
    "novelty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["names", "verbs", "template", "jointly_unseen"],
      "properties": {
        "names": {"enum": ["development", "split_exclusive"]},
        "verbs": {"enum": ["development", "split_exclusive"]},
        "template": {"enum": ["development", "split_exclusive"]},
        "jointly_unseen": {"type": "boolean"}
      }
    },
    "entities": {"type": "array", "minItems": 2, "items": {"type": "object"}},
    "events": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["event_id", "sequence", "subject", "predicate", "object", "dependencies", "text"],
        "properties": {
          "event_id": {"type": "string"}, "sequence": {"type": "integer", "minimum": 0},
          "subject": {"type": "string"}, "predicate": {"type": "string"}, "object": {"type": "string"},
          "dependencies": {"type": "array", "items": {"type": "string"}}, "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "intervention": {
      "type": "object", "additionalProperties": false,
      "required": ["changed_event_id", "world_a_value", "world_b_value", "unchanged_event_ids"],
      "properties": {
        "changed_event_id": {"type": "string"}, "world_a_value": {"type": "string"},
        "world_b_value": {"type": "string"}, "unchanged_event_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "candidates": {"$ref": "#/$defs/candidates"},
    "worlds": {
      "type": "object", "additionalProperties": false, "required": ["A", "B"],
      "properties": {"A": {"$ref": "#/$defs/world"}, "B": {"$ref": "#/$defs/world"}}
    },
    "controls": {
      "type": "object", "additionalProperties": false,
      "required": ["fact_removed_context", "irrelevant_substituted_context"],
      "properties": {"fact_removed_context": {"type": "string"}, "irrelevant_substituted_context": {"type": "string"}}
    },
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["genre", "source", "authoring_revision"],
      "properties": {"genre": {"type": "string"}, "source": {"const": "benchmark-v2-authored"}, "authoring_revision": {"type": "string"}}
    }
  },
  "$defs": {
    "candidate": {
      "type": "object", "additionalProperties": false, "required": ["text"],
      "properties": {"text": {"type": "string", "minLength": 1}, "token_ids": {"type": "array", "items": {"type": "integer", "minimum": 0}}}
    },
    "candidates": {
      "type": "object", "additionalProperties": false, "required": ["X", "Y"],
      "properties": {"X": {"$ref": "#/$defs/candidate"}, "Y": {"$ref": "#/$defs/candidate"}}
    },
    "world": {
      "type": "object", "additionalProperties": false,
      "required": ["context", "correct_candidate", "proof", "gold_continuation", "counterfactual_continuation", "free_generation"],
      "properties": {
        "context": {"type": "string", "minLength": 1}, "correct_candidate": {"enum": ["X", "Y"]},
        "proof": {
          "type": "object", "additionalProperties": false, "required": ["supporting_event_ids", "inference_chain", "answer_value"],
          "properties": {
            "supporting_event_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "inference_chain": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "answer_value": {"type": "string"}
          }
        },
        "gold_continuation": {"type": "string", "minLength": 1}, "counterfactual_continuation": {"type": "string", "minLength": 1},
        "free_generation": {
          "type": "object", "additionalProperties": false,
          "required": ["prompt", "required_propositions", "forbidden_propositions", "review_question"],
          "properties": {
            "prompt": {"type": "string", "minLength": 1},
            "required_propositions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "forbidden_propositions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "review_question": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
