{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BearCatCoder/FictionPulper/schemas/continuation-pilot-v1.schema.json",
  "title": "FictionPulper continuation pilot v1 canonical example",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "example_id", "opening", "continuation", "genre", "premise", "protagonist", "protagonist_motive", "character_names", "atomic_facts", "primary_state_family", "event_transitions", "stale_state_distractor_present", "action_summary", "consequence_summary", "duplicate_cluster_id", "authoring_inputs", "rights", "provenance"],
  "properties": {
    "schema_version": {"const": 1},
    "example_id": {"type": "string", "pattern": "^cpv1-[a-z0-9][a-z0-9-]*$"},
    "opening": {"type": "string", "minLength": 1, "pattern": "\\n\\n$"},
    "continuation": {"type": "string", "minLength": 1, "pattern": "^\\S"},
    "genre": {"enum": ["crime_noir", "horror_occult", "science_fiction", "western_adventure", "weird_fantasy"]},
    "premise": {"type": "string", "minLength": 1},
    "protagonist": {"type": "string", "minLength": 1},
    "protagonist_motive": {"type": "string", "minLength": 1},
    "character_names": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "atomic_facts": {"type": "array", "minItems": 3, "maxItems": 5, "items": {"type": "string", "minLength": 1}},
    "primary_state_family": {"enum": ["possession", "location", "knowledge", "goal", "causal_update"]},
    "event_transitions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["transition_id", "state_family", "before", "event", "after", "evidence"],
        "properties": {
          "transition_id": {"type": "string", "minLength": 1},
          "state_family": {"enum": ["possession", "location", "knowledge", "goal", "causal_update"]},
          "before": {"type": "string", "minLength": 1},
          "event": {"type": "string", "minLength": 1},
          "after": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "object", "additionalProperties": false,
            "required": ["before_quote", "event_quote", "after_quote"],
            "properties": {
              "before_quote": {"type": "string", "minLength": 1},
              "event_quote": {"type": "string", "minLength": 1},
              "after_quote": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "stale_state_distractor_present": {"type": "boolean"},
    "action_summary": {"type": "string", "minLength": 1},
    "consequence_summary": {"type": "string", "minLength": 1},
    "duplicate_cluster_id": {"type": "string", "minLength": 1},
    "authoring_inputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "rights": {
      "type": "object", "additionalProperties": false,
      "required": ["basis", "license_or_status", "evidence_reference", "evidence_sha256", "rights_holder_or_author"],
      "properties": {
        "basis": {"enum": ["original_commission", "author_permission", "public_domain", "cc0", "cc_by"]},
        "license_or_status": {"type": "string", "minLength": 1},
        "evidence_reference": {"type": "string", "minLength": 1},
        "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "rights_holder_or_author": {"type": "string", "minLength": 1}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "original_story_id", "source_reference", "source_sha256", "authoring_method", "baseline_training_exposure"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "original_story_id": {"type": "string", "minLength": 1},
        "source_reference": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "authoring_method": {"enum": ["independently_authored", "rights_cleared_extract"]},
        "baseline_training_exposure": {"enum": ["none", "identified_exposure"]}
      }
    }
  }
}
